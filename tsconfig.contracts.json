{
  "compilerOptions": {
    "composite": true,
    "strict": true,
    "target": "ES2023",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "skipLibCheck": true,
    "noEmit": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true
  },
  "include": ["packages/core/src/**/*.ts"],
  "exclude": ["packages/core/src/**/*.test.ts"]
}

{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scriptor Mobile",
  "version": "1.2.8",
  "identifier": "com.scriptor.mobile",
  "build": {
    "beforeDevCommand": "pnpm dev", "devUrl": "http://localhost:1421",
    "beforeBuildCommand": "pnpm build", "frontendDist": "../dist"
  },
  "app": {
    "windows": [{ "title": "Scriptor Mobile", "width": 390, "height": 844 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src 'self' ipc: http://ipc.localhost https://ipc.localhost; object-src 'none'; base-uri 'self'; form-action 'self'"
    }
  },
  "bundle": { "active": true, "targets": "all", "icon": ["../../desktop/src-tauri/icons/icon.ico", "../../desktop/src-tauri/icons/icon.png"], "iOS": { "minimumSystemVersion": "15.0" }, "android": { "minSdkVersion": 26 } }
}

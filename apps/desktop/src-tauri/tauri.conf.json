{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Scriptor",
  "version": "0.1.0",
  "identifier": "com.scriptor.desktop",
  "build": {
    "beforeDevCommand": "pnpm --dir ../.. dev --host 127.0.0.1",
    "devUrl": "http://127.0.0.1:5173",
    "beforeBuildCommand": "pnpm --dir ../.. build",
    "beforeBundleCommand": "node ../../scripts/release/stage-daemon-sidecar.mjs",
    "frontendDist": "../../../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Scriptor",
        "width": 1440,
        "height": 900,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "active": true,
      "endpoints": ["https://releases.scriptor.app/{{target}}/{{current_version}}"],
      "dialog": true,
      "pubkey": "dW5kZWZpbmVk"
    },
    "deep-link": {
      "desktop": {
        "schemes": ["scriptor"]
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": ["binaries/*"],
    "fileAssociations": [
      {
        "ext": ["md", "markdown"],
        "name": "Markdown Note",
        "role": "Editor",
        "mimeType": "text/markdown"
      }
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "macOS": {
      "minimumSystemVersion": "10.15",
      "signingIdentity": "-"
    }
  }
}

# Dependencies
node_modules/

# Build output
dist/
dist-ssr/
target/

# Root-level build artifact leaks (protect tracked index.html source)
/assets/

# Release publication scratch
/release-artifacts/
/release-evidence/
/release-output/
# Local smoke-test directories produced by generate-update-manifests dry runs
/release-artifacts-test/
/release-manifests-test/
# CI-generated update manifests (only live inside the publish-update-manifests job)
/update-manifests/

# Vite / TypeScript
*.local
.vite/
*.tsbuildinfo

# Test and coverage
coverage/
test-results/
playwright-report/
blob-report/
playwright/.cache/
playwright/.auth/

# Caches
.turbo/
.cache/
.eslintcache

# Logs
*.log
pnpm-debug.log*
/artifacts/
/ci-logs/
/job_log.txt
/ci.log

# Environment and secrets
.env
.env.*
!.env.example
# Not a secret: enables the mocked Tauri bridge for `vite --mode e2e`.
# Without it VITE_E2E_MODE is undefined and the whole E2E suite runs against
# an app that never opens a vault.
!.env.e2e
*.pem
*.pfx
*.p12
*.key

# OS
.DS_Store
Thumbs.db
ehthumbs.db
Desktop.ini
._*

# Editors
.vscode/*
!.vscode/extensions.json
.idea/
*.swp
*~
*.suo
*.ntvs*
*.njsproj
*.sln

# Local tooling
.impeccable/
.cursor/
.serena/

# Tauri: staged daemon sidecar (built locally; .gitkeep tracked)
apps/desktop/src-tauri/binaries/*
!apps/desktop/src-tauri/binaries/.gitkeep

# Tauri bundle scratch (local installer builds)
apps/desktop/src-tauri/WixTools/

# Merge / patch artifacts
*.orig
*.rej

# SQLite transient WAL/SHM churn from fixture test runs
*.sqlite-wal
*.sqlite-shm

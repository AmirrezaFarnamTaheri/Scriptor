{
  "name": "scriptor",
  "description": "Scriptor — local-first Markdown knowledge workspace",
  "private": true,
  "version": "1.0.1",
  "type": "module",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "license": "AGPL-3.0-or-later",
  "author": "Amirreza \"Farnam\" Taheri <taherifarnam@gmail.com>",
  "homepage": "https://github.com/AmirrezaFarnamTaheri/Scriptor",
  "repository": {
    "type": "git",
    "url": "https://github.com/AmirrezaFarnamTaheri/Scriptor.git"
  },
  "bugs": {
    "url": "https://github.com/AmirrezaFarnamTaheri/Scriptor/issues"
  },
  "scripts": {
    "dev": "pnpm desktop:dev",
    "web:dev": "vite --host 127.0.0.1",
    "web:build": "tsc -b && vite build && node scripts/validation/bundle-graph.mjs",
    "build": "pnpm web:build",
    "check:contracts": "tsc -p tsconfig.contracts.json --noEmit",
    "check:mcp": "node --experimental-strip-types packages/mcp/src/validate-runner.ts",
    "mcp:stdio": "node --experimental-strip-types packages/mcp/src/stdio-server.ts",
    "check:plugins": "node --experimental-strip-types packages/plugin-api/src/validate-runner.ts",
    "check:canvas": "node --experimental-strip-types packages/canvas/src/validate-runner.ts",
    "check:editor": "node --experimental-strip-types packages/editor/src/validate-runner.ts",
    "check:portal": "node --experimental-strip-types packages/portal/src/validate-runner.ts",
    "check:renderer": "node --experimental-strip-types packages/renderer/src/validate-runner.ts",
    "check:export": "node --experimental-strip-types packages/export/src/validate-runner.ts",
    "check:tui": "node scripts/validation/tui-smoke.mjs",
    "check:daemon": "node scripts/validation/daemon-smoke.mjs",
    "check:headless": "node --experimental-strip-types src/lib/validate-headless-runner.ts",
    "export:headless": "node scripts/ci/export-vault.mjs",
    "check:manifest": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/release/verify-manifest.ps1",
    "check:container": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/validation/container-smoke.ps1",
    "check:perf": "node scripts/benchmarks/check-baselines.mjs",
    "check:ts-rs": "cargo test -p scriptor-ipc",
    "check:xtask": "cargo xtask release-smoke",
    "check:deny": "cargo deny check",
    "check:audit": "pnpm audit --prod",
    "check:citations": "node --experimental-strip-types src/lib/validate-citation-runner.ts",
    "check:safe-external-url": "node --experimental-strip-types src/lib/validate-safe-external-url-runner.ts",
    "check:zotero": "pnpm --dir packages/zotero-connector check:zotero",
    "check:knowledge": "node --experimental-strip-types src/lib/validate-knowledge-runner.ts",
    "check:merge": "node --experimental-strip-types src/lib/validate-merge-runner.ts",
    "check:palette-score": "node --experimental-strip-types src/lib/validate-palette-score-runner.ts",
    "check:rust": "pnpm check:rust:product && pnpm check:rust:incubating",
    "test:rust": "cargo test --locked --workspace --exclude scriptor-desktop --exclude scriptor-citation-engine --exclude scriptor-embeddings --exclude scriptor-tantivy-indexer --exclude scriptor-wasm-runtime --jobs 2",
    "prepare:desktop": "node scripts/release/stage-daemon-sidecar.mjs",
    "desktop:dev": "pnpm prepare:desktop && pnpm --dir apps/desktop dev",
    "desktop:build": "pnpm --dir apps/desktop build",
    "icons:regenerate": "pnpm --dir apps/desktop exec tauri icon ../../docs/brand/app-icon.svg -o src-tauri/icons --ios-color \"#0f766e\"",
    "screenshots:capture": "powershell -ExecutionPolicy Bypass -File scripts/screenshots/capture.ps1",
    "screenshots:capture:web": "powershell -ExecutionPolicy Bypass -File scripts/screenshots/capture.ps1 -SkipDesktopBuild",
    "release:package": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/release/package.ps1",
    "release:smoke": "pwsh -NoProfile -ExecutionPolicy Bypass -File scripts/release/smoke.ps1",
    "release:perf-gate": "node scripts/benchmarks/check-baselines.mjs --output=artifacts/performance/release-performance.json",
    "check:release": "pnpm check:contracts && pnpm check:mcp && pnpm check:plugins && pnpm check:canvas && pnpm check:editor && pnpm check:renderer && pnpm check:export && pnpm check:portal && pnpm check:knowledge && pnpm check:merge && pnpm check:citations && pnpm check:headless && pnpm lint && pnpm build && pnpm test:rust && pnpm check:tui && pnpm check:daemon && pnpm check:container && pnpm release:smoke && pnpm release:perf-gate && pnpm bench:canvas && pnpm bench:startup && pnpm bench:idle-memory && pnpm check:a11y && pnpm check:a11y-axe && pnpm test:e2e && pnpm test:visual",
    "cli": "cargo run -p scriptor-cli --",
    "bench:vault-scan": "powershell -ExecutionPolicy Bypass -File scripts/benchmarks/vault-scan.ps1",
    "bench:search": "powershell -ExecutionPolicy Bypass -File scripts/benchmarks/search.ps1",
    "bench:scan-1k": "powershell -ExecutionPolicy Bypass -File scripts/benchmarks/bench-large.ps1 -Size 1k",
    "bench:scan-5k": "powershell -ExecutionPolicy Bypass -File scripts/benchmarks/bench-large.ps1 -Size 5k",
    "bench:scan-100": "powershell -ExecutionPolicy Bypass -File scripts/benchmarks/bench-large.ps1 -Size 100",
    "bench:scan-25k": "powershell -ExecutionPolicy Bypass -File scripts/benchmarks/bench-large.ps1 -Size 25k",
    "bench:search-1k": "powershell -ExecutionPolicy Bypass -File scripts/benchmarks/bench-large.ps1 -Size 1k -Mode search",
    "bench:editor-latency": "powershell -ExecutionPolicy Bypass -File scripts/benchmarks/editor-latency.ps1",
    "bench:large-note": "powershell -ExecutionPolicy Bypass -File scripts/benchmarks/large-note-open.ps1",
    "bench:canvas": "powershell -ExecutionPolicy Bypass -File scripts/benchmarks/canvas-interaction.ps1",
    "bench:canvas-snapshot": "powershell -ExecutionPolicy Bypass -File scripts/benchmarks/canvas-snapshot.ps1",
    "release:export-smoke": "powershell -ExecutionPolicy Bypass -File scripts/release/export-smoke.ps1",
    "release:packaged-smoke": "powershell -ExecutionPolicy Bypass -File scripts/release/packaged-smoke.ps1",
    "check:a11y": "node scripts/validation/a11y-smoke.mjs",
    "check:a11y-axe": "node scripts/validation/a11y-axe.mjs",
    "bench:startup": "powershell -ExecutionPolicy Bypass -File scripts/benchmarks/startup.ps1",
    "bench:idle-memory": "powershell -ExecutionPolicy Bypass -File scripts/benchmarks/idle-memory.ps1",
    "fixtures:synthetic": "powershell -ExecutionPolicy Bypass -File scripts/fixture-import/generate-synthetic-vault.ps1",
    "fixtures:synthetic-1k": "powershell -ExecutionPolicy Bypass -File scripts/fixture-import/generate-synthetic-vault.ps1 -Count 1000 -Output packages/test-fixtures/vaults/synthetic-1k",
    "fixtures:synthetic-5k": "powershell -ExecutionPolicy Bypass -File scripts/fixture-import/generate-synthetic-vault.ps1 -Count 5000 -Output packages/test-fixtures/vaults/synthetic-5k",
    "fixtures:synthetic-100": "powershell -ExecutionPolicy Bypass -File scripts/fixture-import/generate-synthetic-vault.ps1 -Count 100 -Output packages/test-fixtures/vaults/synthetic-100",
    "fixtures:synthetic-25k": "powershell -ExecutionPolicy Bypass -File scripts/fixture-import/generate-synthetic-vault.ps1 -Count 25000 -Output packages/test-fixtures/vaults/synthetic-25k",
    "lint": "eslint . --max-warnings=0",
    "preview": "vite preview",
    "test:e2e": "playwright test --config playwright.e2e.config.ts",
    "test:visual": "playwright test --config playwright.visual.config.ts",
    "check:visual": "playwright test --config playwright.visual.config.ts",
    "version:check": "node scripts/release/version.mjs check",
    "version:sync": "node scripts/release/version.mjs sync",
    "lint:actions": "node scripts/validation/action-pins.mjs",
    "lint:boundaries": "node scripts/validation/deep-module-boundaries.mjs",
    "check:i18n": "node scripts/validation/i18n-parity.mjs",
    "check:docs": "node scripts/validation/docs-contracts.mjs",
    "release:sbom": "node scripts/release/generate-sbom.mjs",
    "release:receipt": "node scripts/release/create-receipt.mjs",
    "release:evidence:verify": "node scripts/release/verify-release-evidence.mjs",
    "check:source": "pnpm check:operation-contracts && node scripts/validation/source-contracts.mjs && node scripts/validation/desktop-branding.mjs && node scripts/validation/rust-source-contracts.mjs && node scripts/validation/authorization-inventory.mjs && node scripts/validation/frontend-quality.mjs && node scripts/validation/module-size-ratchet.mjs && node scripts/validation/rustsec-exceptions.mjs && node scripts/validation/deep-module-boundaries.mjs && node scripts/validation/tauri-command-contracts.mjs && node scripts/validation/cargo-lock-workspace-deps.mjs && node scripts/validation/plugin-rust-gates.mjs && pnpm test:source",
    "check:governance": "node scripts/release/version.mjs check && node scripts/validation/action-pins.mjs && node scripts/validation/deep-module-boundaries.mjs && node scripts/validation/i18n-parity.mjs && node scripts/validation/docs-contracts.mjs && node scripts/validation/frontend-quality.mjs && node scripts/validation/module-size-ratchet.mjs && node scripts/validation/rustsec-exceptions.mjs && node scripts/validation/cargo-lock-workspace-deps.mjs && node scripts/validation/plugin-rust-gates.mjs",
    "check:rust:product": "cargo check --locked",
    "check:rust:incubating": "cargo check --locked -p scriptor-citation-engine -p scriptor-embeddings -p scriptor-tantivy-indexer -p scriptor-wasm-runtime",
    "test:rust:product": "cargo test --locked --workspace --exclude scriptor-desktop --exclude scriptor-citation-engine --exclude scriptor-embeddings --exclude scriptor-tantivy-indexer --exclude scriptor-wasm-runtime --jobs 2",
    "test:core": "node --experimental-strip-types --test packages/core/src/**/*.test.ts",
    "check:rust-source": "node scripts/validation/rust-source-contracts.mjs",
    "check:authorization": "node scripts/validation/authorization-inventory.mjs",
    "check:frontend-quality": "node scripts/validation/frontend-quality.mjs && node scripts/validation/css-custom-properties.mjs",
    "check:bundle": "node scripts/validation/bundle-graph.mjs",
    "check:benchmark-contracts": "node --test scripts/benchmarks/benchmark-utils.test.mjs",
    "check:release-evidence-contracts": "node --test scripts/release/source-identity.test.mjs scripts/release/release-evidence-utils.test.mjs scripts/release/sbom-utils.test.mjs scripts/release/signing-policy.test.mjs",
    "check:release-signing": "node --test scripts/release/signing-policy.test.mjs",
    "check:release-hardening": "node --test scripts/validation/release-hardening-contracts.test.mjs",
    "check:rustsec-exceptions": "node scripts/validation/rustsec-exceptions.mjs",
    "check:branding": "node scripts/validation/desktop-branding.mjs",
    "test:source": "node scripts/validation/run-source-tests.mjs",
    "check:cargo-lock": "node scripts/validation/cargo-lock-workspace-deps.mjs",
    "check:plugin-rust-gates": "node scripts/validation/plugin-rust-gates.mjs",
    "check:packaging-profile": "node --test scripts/packaging/zip-lite.test.mjs",
    "check:docs-contracts": "node --test scripts/validation/docs-contract-utils.test.mjs && node scripts/validation/docs-contracts.mjs",
    "release:quality": "node scripts/release/run-release-quality.mjs",
    "release:attestations:verify": "node scripts/release/verify-github-attestations.mjs",
    "release:evidence:create": "node scripts/release/create-evidence-graph.mjs",
    "release:evidence:doctor": "node scripts/release/verify-evidence-graph.mjs",
    "check:operation-contracts": "node scripts/contracts/generate-operation-contracts.mjs --check && node --test scripts/contracts/operation-contracts.test.mjs"
  },
  "dependencies": {
    "@codemirror/theme-one-dark": "^6.1.3",
    "@monaco-editor/react": "^4.7.0",
    "@scriptor/canvas": "workspace:*",
    "@scriptor/core": "workspace:*",
    "@scriptor/editor": "workspace:*",
    "@scriptor/export": "workspace:*",
    "@scriptor/mcp": "workspace:*",
    "@scriptor/plugin-api": "workspace:*",
    "@scriptor/plugin-canvas-kit": "workspace:*",
    "@scriptor/plugin-gmail-manager": "workspace:*",
    "@scriptor/plugin-pdf-translate": "workspace:*",
    "@scriptor/plugin-publish-pack": "workspace:*",
    "@scriptor/plugin-vault-lint": "workspace:*",
    "@scriptor/portal": "workspace:*",
    "@scriptor/renderer": "workspace:*",
    "@scriptor/template-engine": "workspace:*",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-dialog": "^2.7.2",
    "chart.js": "^4.4.8",
    "citeproc": "^2.4.63",
    "d3-force": "^3.0.0",
    "epubjs": "^0.3.93",
    "immer": "^11.1.18",
    "lucide-react": "^1.33.0",
    "monaco-editor": "^0.56.0",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@axe-core/cli": "^4.13.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@vitejs/plugin-react": "^6.1.0",
    "eslint": "^10.9.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.4",
    "globals": "^17.11.0",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.2"
  }
}
